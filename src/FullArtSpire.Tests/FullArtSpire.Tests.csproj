<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Import Project="..\Sts2PathDiscovery.props" />
  <ItemGroup>
    <ProjectReference Include="..\FullArtSpire\FullArtSpire.csproj" />
    <Reference Include="0Harmony"><HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(Sts2DataDir)\GodotSharp.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="sts2"><HintPath>$(Sts2DataDir)\sts2.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="BaseLib"><HintPath>..\FullArtSpire\lib\BaseLib.dll</HintPath><Private>true</Private></Reference>
    <!-- Newer game assemblies expose Sentry types through their API metadata. -->
    <Reference Include="Sentry.Godot" Condition="Exists('$(Sts2DataDir)/Sentry.Godot.dll')"><HintPath>$(Sts2DataDir)\Sentry.Godot.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Sentry" Condition="Exists('$(Sts2DataDir)/Sentry.dll')"><HintPath>$(Sts2DataDir)\Sentry.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
